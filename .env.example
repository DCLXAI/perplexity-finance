# -----------------------------------------------------------------------------
# Browser-safe public configuration
# Never place service-role keys, provider secrets, or delivery secrets in VITE_*.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ENABLE_LIVE_DATA=true
VITE_MARKET_POLL_MS=20000

# -----------------------------------------------------------------------------
# Deployment identity and request boundaries
# Production PUBLIC_ORIGIN must be HTTPS. ALLOWED_ORIGINS is comma-separated.
# -----------------------------------------------------------------------------
PUBLIC_ORIGIN=http://localhost:5602
ALLOWED_ORIGINS=http://localhost:5602,http://localhost:5603
RELEASE_CHANNEL=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Market data providers
# primary: Alpaca only when available
# failover: Alpaca -> Finnhub (equities) / Coinbase (crypto)
# quorum: reconcile multiple configured providers and quarantine deviations
# -----------------------------------------------------------------------------
MARKET_PROVIDER_MODE=failover
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
FINNHUB_API_KEY=
FINNHUB_MODE=delayed
COINBASE_ENABLED=false
ALPHA_VANTAGE_API_KEY=
ALLOW_MOCK_FALLBACK=true
MARKET_POLL_MS=20000

# Cache, stale-data, quality, and circuit-breaker policy
QUOTE_CACHE_SECONDS=12
HISTORY_CACHE_SECONDS=300
CONTENT_CACHE_SECONDS=120
STALE_IF_ERROR_SECONDS=900
LAST_KNOWN_GOOD_SECONDS=86400
HISTORY_STALE_SECONDS=86400
QUOTE_MAX_AGE_STOCK_SECONDS=120
QUOTE_MAX_AGE_CRYPTO_SECONDS=90
QUOTE_MAX_DEVIATION_BPS=75
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_OPEN_MS=30000

# -----------------------------------------------------------------------------
# Cloud persistence and authenticated APIs
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Financial AI tool calling
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# -----------------------------------------------------------------------------
# Durable alert evaluation and delivery
# Keep CRON_SECRET, METRICS_SECRET, and OPS_SECRET distinct in production.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
ALERT_EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
CRON_SECRET=
METRICS_SECRET=
OPS_SECRET=
OPS_ROLES=ops,admin

ALERT_BATCH_SIZE=250
ALERT_EVALUATION_INTERVAL_SECONDS=60
ALERT_EVALUATION_LEASE_SECONDS=90
ALERT_MAX_PER_USER=100
DELIVERY_BATCH_SIZE=50
DELIVERY_CONCURRENCY=5
DELIVERY_TIMEOUT_MS=12000
RETENTION_DAYS=90
MARKET_CAPTURE_LIMIT=120
PORTFOLIO_SNAPSHOT_LIMIT=8
REBALANCE_SCAN_LIMIT=20
CONTRIBUTION_SCAN_LIMIT=10

# -----------------------------------------------------------------------------
# Optional distributed cache and rate limiting
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Release-gate policy
# Turn requirements on only after the corresponding production integration is
# configured and verified. /api/ready returns 503 when a required check fails.
# -----------------------------------------------------------------------------
RELEASE_MIN_AVAILABILITY_PCT=99
RELEASE_MAX_P95_LATENCY_MS=2500
REQUIRE_LIVE_DATA=false
REQUIRE_CLOUD=false
REQUIRE_DURABLE_ALERTS=false
REQUIRE_AI=false
